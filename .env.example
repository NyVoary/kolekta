# Copier ce fichier en .env puis adapter. Le fichier .env n'est jamais versionné.
# Toutes les valeurs ci-dessous sont factices.

# --- Base de données ---
DB_NAME=kolekta
DB_USER=kolekta
DB_PASSWORD=change-me-db-password
# Utilisée seulement quand l'API tourne SANS Docker (Docker Compose la fixe lui-même vers le service "db")
DB_URL=jdbc:postgresql://localhost:5433/kolekta
# Port de PostgreSQL exposé sur ta machine (5433 pour ne pas gêner un PostgreSQL local sur 5432)
DB_PORT=5433

# --- JWT ---
# Obligatoire, au moins 32 caractères. Générer par exemple : openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRATION=3600000
